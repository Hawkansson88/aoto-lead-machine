#authGate.show{display:grid}
.auth-card{width:362px;max-width:90vw;background:var(--surface);border-radius:18px;padding:34px 32px;box-shadow:0 30px 80px -20px rgba(0,0,0,.6)}
.auth-card .brand{justify-content:center;margin-bottom:10px}
.auth-card h2{font-family:'Archivo';font-weight:700;text-align:center;margin:4px 0 4px;font-size:20px;color:var(--ink)}
.auth-card p.lead{text-align:center;color:var(--muted);font-size:13px;margin:0 0 22px}
.field{margin-bottom:13px}
.field label{display:block;font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:6px;letter-spacing:.3px}
.field input{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:14px;background:var(--surface-2)}
.field input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft);background:#fff}
.auth-err{color:var(--sc-low);font-size:12.5px;min-height:16px;margin:2px 0 10px}
</style>
</head>
<body>

<div id="authGate">
  <div class="auth-card">
    <div class="brand"><div class="mark">A</div></div>
    <h2>Lead Machine</h2>
    <p class="lead">Logga in för att fortsätta</p>
    <div class="field"><label>E-post</label><input id="authEmail" type="email" autocomplete="username"></div>
    <div class="field"><label>Lösenord</label><input id="authPw" type="password" autocomplete="current-password"></div>
    <div class="auth-err" id="authErr"></div>
    <button class="btn btn-acc" id="authBtn">Logga in</button>
  </div>
</div>

<div class="app" id="app">
  <aside class="sidebar">
    <div class="brand">
      <div class="mark">A</div>
      <div class="wm">Lead Machine<small>CRM · Lagerfinansiering</small></div>
    </div>
    <div class="stat-grid" id="stats"></div>
    <p class="section-label">Status</p>
    <div class="status-list" id="statusList"></div>
    <div class="slider-wrap">
      <div class="slider-head">
        <p class="section-label" style="margin:0">Min. score</p>
        <b class="num" id="scoreVal">0</b>
      </div>
      <input type="range" id="scoreSlider" min="0" max="100" value="0" step="5">
    </div>
    <div class="rev-filter">
      <p class="section-label" style="margin-bottom:8px">Omsättning (MSEK)</p>
      <div class="rev-inputs">
        <input type="number" id="revMin" placeholder="Min" min="0">
        <span>–</span>
        <input type="number" id="revMax" placeholder="Max" min="0">
      </div>
    </div>
    <button class="save-filters-btn" id="saveFiltersBtn">Spara filter</button>
    <div class="filter-saved" id="filterSavedMsg">✓ Filter sparat</div>
    <div class="user-foot">
      <div class="av" id="userAv">–</div>
      <div class="em" id="userEmail">–</div>
      <button class="settings-btn" id="settingsBtn" title="Scoring-inställningar">⚙</button>
      <button class="lo" id="logoutBtn">Logga ut</button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div>
        <h1>Bilhandlare</h1>
        <div class="sub"><span id="resultCount">0</span> leads · sorterade efter potential</div>
      </div>
      <div class="search">
        <span class="ic">⌕</span>
        <input id="search" placeholder="Sök företag, stad, org.nr…" autocomplete="off">
      </div>
      <button class="btn btn-ghost" id="mapBtn" style="font-size:12px;padding:7px 13px">🗺 Karta</button>
      <button class="btn btn-ghost" id="geocodeBtn" style="display:none;font-size:12px;padding:7px 13px">📍 Geocoda</button>
      <button class="btn btn-ghost" id="importBtn" style="display:none;font-size:12px;padding:7px 13px">⬇ Importera</button>
      <button class="btn btn-ghost" id="enrichBtn" style="display:none;font-size:12px;padding:7px 13px">⚙ Anrika 20</button>
      <span class="conn-pill live"><span class="d"></span>Live · Supabase</span>
    </header>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th data-sort="score" class="right">Score</th>
            <th data-sort="company_name">Företag</th>
            <th data-sort="city">Stad</th>
            <th data-sort="revenue" class="right">Omsättning</th>
            <th data-sort="employees" class="right">Anställda</th>
            <th data-sort="follow_up_date">Uppföljning</th>
            <th data-sort="status">Status</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      <div class="empty" id="empty" style="display:none">Inga leads matchar filtren.</div>
    </div>
  </main>
</div>

<!-- DETAIL PANEL -->
<div class="scrim" id="scrim"></div>
<aside class="panel" id="panel">
  <div class="p-head">
    <div class="p-head-actions">
      <button class="btn-icon" id="mailBtn" title="Skicka kontaktmail">✉</button>
      <input type="date" id="followup" class="dateinput dateinput-sm">
      <button class="btn btn-prim btn-sm" id="saveFollowup">Spara</button>
      <button class="p-close" id="pClose">✕</button>
    </div>
    <div class="p-score">
      <div class="ring" id="pRing">0</div>
      <div>
        <div class="p-name" id="pName">—</div>
        <div class="p-meta num" id="pMeta">—</div>
      </div>
    </div>
  </div>
  <div class="p-body" id="pBody"></div>
</aside>

<!-- SETTINGS MODAL -->
<div class="modal-scrim" id="modalScrim"></div>
<div class="modal" id="settingsModal">
  <div class="modal-head">
    <h2>Scoring-inställningar</h2>
    <button class="p-close" id="modalClose">✕</button>
  </div>
  <div class="modal-body">
    <div class="total-bar">
      <span class="lbl">Total vikt (normaliseras till 0–100)</span>
      <span class="val" id="totalWeight">0p</span>
    </div>
    <div id="scoringParams"></div>
  </div>
  <div class="modal-foot">
    <button class="btn btn-ghost" id="modalCancel">Avbryt</button>
    <button class="btn btn-prim" id="modalSave">Spara inställningar</button>
  </div>
</div>

<!-- KARTA MODAL -->
<div class="modal-scrim" id="mapScrim"></div>
<div class="map-modal" id="mapModal">
  <div class="map-head">
    <div>
      <h2>Karta</h2>
      <div class="sub" id="mapSub">Visar filtrerade leads</div>
    </div>
    <button class="p-close" id="mapClose">✕</button>
  </div>
  <div class="map-no-coords" id="mapNoCoords">Inga bolag med koordinater hittades. Kör "📍 Geocoda" för att hämta positioner.</div>
  <div id="mapContainer"></div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   1. KONFIG
   ============================================================ */
const SUPABASE_URL  = "https://plydduphthqhpmwasznr.supabase.co";
const SUPABASE_ANON = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBseWRkdXBodGhxaHBtd2Fzem5yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1MTcxNjksImV4cCI6MjA5NjA5MzE2OX0.fdxR8DXxFjsT0f7fL0LamsNTj6WdFx5R_rFdi67SNWo";
let sb = null;

/* ============================================================
   2. SCORING
   ============================================================ */
const DEFAULT_SCORING = {
  revenue:   { weight: 35, sweet_low: 10, sweet_high: 120, max: 200 },
  employees: { weight: 25, min: 5, max: 50 },
  solidity:  { weight: 25, breaks: [15, 30, 45], points: [25, 18, 11, 4] },
  result:    { weight: 10, breaks: [-5, 0, 5], points: [0, 4, 8, 10] },
};
let scoringCfg = JSON.parse(JSON.stringify(DEFAULT_SCORING));

function scoreBreakdown(l) {
  if (l.org_nr == null) return { total: null, parts: [], notEnriched: true };
  const cfg = scoringCfg;

  const mskr = (l.revenue || 0) / 1e6;
  let oms = 0;
  const sw = cfg.revenue.sweet_low, sh = cfg.revenue.sweet_high, rm = cfg.revenue.max;
  if (mskr >= sw && mskr <= sh) oms = cfg.revenue.weight;
  else if (mskr > sh && mskr <= rm) oms = cfg.revenue.weight - ((mskr - sh) / (rm - sh)) * (cfg.revenue.weight * 0.35);
  else if (mskr > 0 && mskr < sw) oms = (mskr / sw) * (cfg.revenue.weight * 0.5);
  oms = Math.max(0, Math.round(oms));

  const e = l.employees || 0;
  let ans = 0;
  const emin = cfg.employees.min, emax = cfg.employees.max, ew = cfg.employees.weight;
  if (e >= emin && e <= emax) ans = ew;
  else if (e > 0 && e < emin) ans = (e / emin) * (ew * 0.6);
  else if (e > emax) ans = Math.max(ew * 0.3, ew - ((e - emax) / emax) * ew);
  ans = Math.round(ans);

  const s = l.solidity == null ? 40 : l.solidity;
  const sb_ = cfg.solidity.breaks, sp = cfg.solidity.points;
  let sol = s <= sb_[0] ? sp[0] : s <= sb_[1] ? sp[1] : s <= sb_[2] ? sp[2] : sp[3];

  let res = 0;
  if (l.result_after_fin != null && l.revenue) {
    const rp = cfg.result;
    const pct = (l.result_after_fin / l.revenue) * 100;
    const rb = rp.breaks, rpts = rp.points;
    res = pct <= rb[0] ? rpts[0] : pct <= rb[1] ? rpts[1] : pct <= rb[2] ? rpts[2] : rpts[3];
  }

  const parts = [
    { lab: "Omsättning",  pts: oms, max: cfg.revenue.weight },
    { lab: "Anställda",   pts: ans, max: cfg.employees.weight },
    { lab: "Soliditet",   pts: sol, max: cfg.solidity.weight },
    { lab: "Resultat",    pts: res, max: cfg.result.weight },
  ];
  const rawTotal = parts.reduce((a, p) => a + p.pts, 0);
  const maxTotal = parts.reduce((a, p) => a + p.max, 0);
  return { total: Math.min(100, maxTotal > 0 ? Math.round((rawTotal / maxTotal) * 100) : 0), parts, notEnriched: false };
}

/* ============================================================
   3. STATE + HJÄLPARE
   ============================================================ */
let LEADS = [];
let sel = null;
let appReady = false;
let leafletMap = null;
let markerCluster = null;
const state = { status: "alla", minScore: 0, revMin: null, revMax: null, q: "", sortKey: "score", sortDir: -1 };

const STATUS = {
  ny:        { label: "Ej kontaktad", cls: "b-ny",        col: "var(--st-ny)" },
  kontaktad: { label: "Kontaktad",    cls: "b-kontaktad", col: "var(--st-kontaktad)" },
  mote:      { label: "Möte bokat",   cls: "b-mote",      col: "var(--st-mote)" },
  ejaktuell: { label: "Ej intressant",cls: "b-ejaktuell", col: "var(--st-ej)" },
};

const $ = s => document.querySelector(s);
const fmtMSEK = v => v == null ? "–" : (v / 1e6).toLocaleString("sv-SE", { maximumFractionDigits: 1 }) + " MSEK";
const scoreColor = sc => sc >= 80 ? "var(--sc-high)" : sc >= 50 ? "var(--sc-mid)" : "var(--sc-low)";
const scoreColorHex = sc => sc >= 80 ? "#11a37a" : sc >= 50 ? "#e0a23a" : "#e0556b";
const scoreBarColor = (pts, max) => { const r = pts / max; return r >= 0.7 ? "var(--sc-high)" : r >= 0.4 ? "var(--sc-mid)" : "var(--sc-low)"; };

function toast(msg) {
  const t = $("#toast"); t.textContent = msg; t.classList.add("show");
  clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove("show"), 2200);
}
function todayStr() { return new Date().toISOString().slice(0, 10); }
function followupInfo(d) {
  if (!d) return { label: "–", cls: "fu-none" };
  const fmt = new Date(d + "T00:00:00").toLocaleDateString("sv-SE", { day: "numeric", month: "short" });
  if (d < todayStr()) return { label: `${fmt} · försenad`, cls: "fu-late" };
  if (d === todayStr()) return { label: `${fmt} · idag`, cls: "fu-today" };
  return { label: fmt, cls: "fu-future" };
}
function fmtDateTime(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString("sv-SE", { day: "numeric", month: "short", year: "numeric" }) + " kl " + d.toLocaleTimeString("sv-SE", { hour: "2-digit", minute: "2-digit" });
}
function noteHtml(n) {
  return `<div class="note-item"><div class="meta">${fmtDateTime(n.created_at)}</div><div class="txt">${n.note.replace(/</g, "&lt;")}</div></div>`;
}
function renderNotesList(notes) {
  const el = $("#notesList"); if (!el) return;
  const lc = $("#lastContact");
  if (lc) lc.textContent = notes.length ? `Senaste kontakt: ${fmtDateTime(notes[0].created_at)}` : "Senaste kontakt: –";
  el.innerHTML = notes.length ? notes.map(noteHtml).join("") : `<div class="notes-empty">Inga anteckningar ännu.</div>`;
}

/* ============================================================
   4. USER SETTINGS
   ============================================================ */
async function loadUserSettings(userId) {
  const { data } = await sb.from("user_settings").select("filters").eq("user_id", userId).maybeSingle();
  if (!data) return;
  const f = data.filters || {};
  if (f.minScore != null) { state.minScore = f.minScore; $("#scoreSlider").value = f.minScore; $("#scoreVal").textContent = f.minScore; $("#scoreSlider").style.setProperty("--p", f.minScore + "%"); }
  if (f.revMin != null)   { state.revMin = f.revMin; $("#revMin").value = f.revMin; }
  if (f.revMax != null)   { state.revMax = f.revMax; $("#revMax").value = f.revMax; }
  if (f.scoring)          { scoringCfg = { ...DEFAULT_SCORING, ...f.scoring }; }
}

async function saveUserSettings(userId, patch) {
  const { data: existing } = await sb.from("user_settings").select("filters").eq("user_id", userId).maybeSingle();
  const merged = { ...(existing?.filters || {}), ...patch };
  const { error } = await sb.from("user_settings").upsert({ user_id: userId, filters: merged, updated_at: new Date().toISOString() });
  return !error;
}

/* ============================================================
   5. DATA
   ============================================================ */
async function loadLeads() {
  const { data, error } = await sb.from("leads").select("*");
  if (error) throw error;
  LEADS = data.map(d => ({ ...d, score: scoreBreakdown(d).total }));
}

async function patchLead(id, fields) {
  const { error } = await sb.from("leads").update(fields).eq("id", id);
  if (error) console.error(error);
  return !error;
}

async function loadContacts(leadId) {
  const el = document.getElementById("contactsList"); if (!el) return;
  const { data, error } = await sb.from("lead_contacts").select("*").eq("lead_id", leadId).order("created_at", { ascending: true });
  if (error || !data || data.length === 0) {
    el.innerHTML = `<span style="font-size:12.5px;color:var(--faint);font-style:italic">Inga kontakter tillagda.</span>`;
    return;
  }
  el.innerHTML = data.map(c => `
    <div class="contact-card">
      <div class="cn">${c.name || "–"}</div>
      <div class="cd">${c.phone ? `<span>${c.phone}</span>` : ""}${c.phone && c.email ? " · " : ""}${c.email ? `<a href="mailto:${c.email}">${c.email}</a>` : ""}</div>
    </div>`).join("");
}

/* ============================================================
   6. FILTRERING + SORTERING
   ============================================================ */
function visible() {
  let r = LEADS.filter(l => {
    if (state.status !== "alla" && l.status !== state.status) return false;
    if ((l.score || 0) < state.minScore) return false;
    if (state.revMin != null && l.revenue != null && l.revenue / 1e6 < state.revMin) return false;
    if (state.revMax != null && l.revenue != null && l.revenue / 1e6 > state.revMax) return false;
    if (state.q) { const q = state.q.toLowerCase(); if (!`${l.company_name} ${l.city} ${l.org_nr || ""}`.toLowerCase().includes(q)) return false; }
    return true;
  });
  const k = state.sortKey, d = state.sortDir;
  r.sort((a, b) => {
    let x = a[k], y = b[k];
    if (k === "follow_up_date") { if (!x && !y) return 0; if (!x) return 1; if (!y) return -1; return x < y ? -d : x > y ? d : 0; }
    if (typeof x === "string") { x = (x || "").toLowerCase(); y = (y || "").toLowerCase(); return x < y ? -d : x > y ? d : 0; }
    return ((x || 0) - (y || 0)) * d;
  });
  return r;
}

/* ============================================================
   7. RENDER
   ============================================================ */
function renderStats() {
  const mote = LEADS.filter(l => l.status === "mote").length;
  const hot  = LEADS.filter(l => l.score >= 80 && l.status !== "ejaktuell").length;
  const fu   = LEADS.filter(l => l.follow_up_date && l.follow_up_date <= todayStr() && l.status !== "ejaktuell").length;
  const unt  = LEADS.filter(l => l.status === "ny" && l.score >= 80).length;
  $("#stats").innerHTML = `
    <div class="stat mote"><span class="spark">📅</span><div class="v num">${mote}</div><div class="l">Möten bokade</div></div>
    <div class="stat hot"><span class="spark">🔥</span><div class="v num">${hot}</div><div class="l">Heta leads (80+)</div></div>
    <div class="stat followup"><span class="spark">⏰</span><div class="v num">${fu}</div><div class="l">Uppföljning idag/försenad</div></div>
    <div class="stat untouched"><span class="spark">✦</span><div class="v num">${unt}</div><div class="l">Orörda · score 80+</div></div>`;
}

function renderStatusFilter() {
  const counts = { alla: LEADS.length };
  Object.keys(STATUS).forEach(k => counts[k] = LEADS.filter(l => l.status === k).length);
  const item = (key, label, col) => `<div class="status-item ${state.status === key ? 'active' : ''}" data-st="${key}"><span class="dot" style="background:${col}"></span>${label}<span class="cnt">${counts[key] || 0}</span></div>`;
  $("#statusList").innerHTML = item("alla", "Alla leads", "#7f8eaa") + Object.entries(STATUS).map(([k, v]) => item(k, v.label, v.col)).join("");
}

function renderTable() {
  const rows = visible();
  $("#resultCount").textContent = rows.length;
  const tb = $("#rows");
  $("#empty").style.display = rows.length ? "none" : "block";
  tb.innerHTML = rows.map(l => {
    const st = STATUS[l.status] || STATUS.ny;
    const fu = followupInfo(l.follow_up_date);
    const scoreCell = l.score == null
      ? `<div class="score-cell"><span class="score-num" style="color:var(--faint)">–</span><span class="score-bar"></span></div>`
      : `<div class="score-cell"><span class="score-num" style="color:${scoreColor(l.score)}">${l.score}</span><span class="score-bar"><span class="score-fill" style="width:${l.score}%;background:${scoreColor(l.score)}"></span></span></div>`;
    return `<tr data-id="${l.id}" class="${sel && sel.id === l.id ? 'sel' : ''}">
      <td class="right">${scoreCell}</td>
      <td><div class="co-name">${l.company_name}</div><div class="co-org num">${l.org_nr || "org.nr ej hämtat"}</div></td>
      <td>${l.city || "–"}</td>
      <td class="right num">${fmtMSEK(l.revenue)}</td>
      <td class="right num">${l.employees ?? "–"}</td>
      <td><span class="${fu.cls}">${fu.label}</span></td>
      <td><span class="badge ${st.cls}"><span class="dot"></span>${st.label}</span></td>
    </tr>`;
  }).join("");
  tb.querySelectorAll("tr").forEach(tr => tr.onclick = () => openPanel(+tr.dataset.id));
}

function renderAll() { renderStats(); renderStatusFilter(); renderTable(); }

/* ============================================================
   8. KARTA
   ============================================================ */
function openMap() {
  const rows = visible().filter(l => l.lat && l.lng);
  const noCoords = $("#mapNoCoords");
  const mapContainer = $("#mapContainer");

  $("#mapSub").textContent = `Visar ${rows.length} av ${visible().length} leads med koordinater`;

  if (rows.length === 0) {
    noCoords.style.display = "block";
    mapContainer.style.display = "none";
  } else {
    noCoords.style.display = "none";
    mapContainer.style.display = "block";
  }

  $("#mapModal").classList.add("open");
  $("#mapScrim").classList.add("open");

  // Initiera karta första gången
  if (!leafletMap) {
    leafletMap = L.map("mapContainer").setView([62.5, 16.5], 5);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(leafletMap);
    markerCluster = L.markerClusterGroup({ maxClusterRadius: 40 });
    leafletMap.addLayer(markerCluster);
  }

  // Rensa gamla markörer
  markerCluster.clearLayers();

  if (rows.length === 0) return;

  rows.forEach(l => {
    const color = scoreColorHex(l.score || 0);
    const icon = L.divIcon({
      className: "",
      html: `<div style="width:14px;height:14px;border-radius:50%;background:${color};border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3)"></div>`,
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });
    const marker = L.marker([l.lat, l.lng], { icon });
    const st = STATUS[l.status] || STATUS.ny;
    marker.bindPopup(`
      <div class="map-popup">
        <div class="name">${l.company_name}</div>
        <span class="score" style="background:${color}">${l.score ?? "–"} p</span>
        <div class="meta">${l.city || "–"} · ${fmtMSEK(l.revenue)} · ${l.employees ?? "–"} anst.</div>
        <div class="meta" style="margin-bottom:8px"><span class="badge ${st.cls}" style="font-size:11px;padding:3px 7px"><span class="dot"></span>${st.label}</span></div>
        <button onclick="openPanelFromMap(${l.id})">Öppna lead →</button>
      </div>`);
    markerCluster.addLayer(marker);
  });

  // Zooma in på synliga markörer
  const bounds = L.featureGroup(markerCluster.getLayers()).getBounds();
  if (bounds.isValid()) leafletMap.fitBounds(bounds, { padding: [40, 40] });

  // Leaflet behöver invalidateSize när den öppnas i en modal
  setTimeout(() => leafletMap.invalidateSize(), 50);
}

function closeMap() {
  $("#mapModal").classList.remove("open");
  $("#mapScrim").classList.remove("open");
}

window.openPanelFromMap = (id) => {
  closeMap();
  setTimeout(() => openPanel(id), 100);
};

/* ============================================================
   9. SETTINGS MODAL
   ============================================================ */
function openSettings() { renderScoringParams(); $("#settingsModal").classList.add("open"); $("#modalScrim").classList.add("open"); }
function closeSettings() { $("#settingsModal").classList.remove("open"); $("#modalScrim").classList.remove("open"); }

function renderScoringParams() {
  const cfg = scoringCfg;
  const params = [
    { key: "revenue", name: "Omsättning", weight: cfg.revenue.weight, fields: [
      { key: "sweet_low",  label: "Sweet spot från (MSEK)", val: cfg.revenue.sweet_low },
      { key: "sweet_high", label: "Sweet spot till (MSEK)", val: cfg.revenue.sweet_high },
      { key: "max",        label: "Max (MSEK)",             val: cfg.revenue.max },
    ]},
    { key: "employees", name: "Anställda", weight: cfg.employees.weight, fields: [
      { key: "min", label: "Min anställda", val: cfg.employees.min },
      { key: "max", label: "Max anställda", val: cfg.employees.max },
    ]},
    { key: "solidity", name: "Soliditet", weight: cfg.solidity.weight, fields: [
      { key: "b0", label: "Brytpunkt 1 (%)", val: cfg.solidity.breaks[0] },
      { key: "b1", label: "Brytpunkt 2 (%)", val: cfg.solidity.breaks[1] },
      { key: "b2", label: "Brytpunkt 3 (%)", val: cfg.solidity.breaks[2] },
      { key: "p0", label: "Poäng ≤ B1",      val: cfg.solidity.points[0] },
      { key: "p1", label: "Poäng B1–B2",     val: cfg.solidity.points[1] },
      { key: "p2", label: "Poäng B2–B3",     val: cfg.solidity.points[2] },
      { key: "p3", label: "Poäng > B3",      val: cfg.solidity.points[3] },
    ]},
    { key: "result", name: "Resultat efter fin.", weight: cfg.result.weight, fields: [
      { key: "b0", label: "Brytpunkt 1 (%)", val: cfg.result.breaks[0] },
      { key: "b1", label: "Brytpunkt 2 (%)", val: cfg.result.breaks[1] },
      { key: "b2", label: "Brytpunkt 3 (%)", val: cfg.result.breaks[2] },
      { key: "p0", label: "Poäng ≤ B1",      val: cfg.result.points[0] },
      { key: "p1", label: "Poäng B1–B2",     val: cfg.result.points[1] },
      { key: "p2", label: "Poäng B2–B3",     val: cfg.result.points[2] },
      { key: "p3", label: "Poäng > B3",      val: cfg.result.points[3] },
    ]},
  ];

  $("#scoringParams").innerHTML = params.map(p => `
    <div class="sc-param" data-param="${p.key}">
      <div class="sc-param-head">
        <span class="name">${p.name}</span>
        <div class="weight-wrap"><label>Vikt</label><input type="number" class="weight-input" data-param="${p.key}" value="${p.weight}" min="0" max="999"></div>
      </div>
      ${p.fields.length ? `<div class="sc-fields">${p.fields.map(f => `<div class="sc-field"><label>${f.label}</label><input type="number" data-param="${p.key}" data-field="${f.key}" value="${f.val}"></div>`).join("")}</div>` : ""}
    </div>`).join("");

  updateTotalWeight();
  $("#scoringParams").querySelectorAll(".weight-input").forEach(inp => { inp.oninput = updateTotalWeight; });
}

function updateTotalWeight() {
  const total = Array.from(document.querySelectorAll(".weight-input")).reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
  $("#totalWeight").textContent = total + "p";
  $("#totalWeight").style.color = total === 0 ? "var(--sc-low)" : "var(--ink)";
}

async function saveScoring(userId) {
  const newCfg = JSON.parse(JSON.stringify(scoringCfg));
  document.querySelectorAll(".weight-input").forEach(inp => { newCfg[inp.dataset.param].weight = parseFloat(inp.value) || 0; });
  document.querySelectorAll(".sc-fields input").forEach(inp => {
    const param = inp.dataset.param, field = inp.dataset.field, val = parseFloat(inp.value);
    if (param === "revenue")   newCfg.revenue[field] = val;
    if (param === "employees") newCfg.employees[field] = val;
    if (param === "solidity")  { if (field.startsWith("b")) newCfg.solidity.breaks[+field[1]] = val; if (field.startsWith("p")) newCfg.solidity.points[+field[1]] = val; }
    if (param === "result")    { if (field.startsWith("b")) newCfg.result.breaks[+field[1]] = val;   if (field.startsWith("p")) newCfg.result.points[+field[1]] = val; }
  });
  scoringCfg = newCfg;
  LEADS = LEADS.map(l => ({ ...l, score: scoreBreakdown(l).total }));
  renderAll();
  const ok = await saveUserSettings(userId, { scoring: newCfg });
  if (ok) { toast("Scoring sparad"); closeSettings(); }
  else toast("Kunde inte spara scoring");
}

/* ============================================================
   10. DETALJPANEL
   ============================================================ */
async function openPanel(id) {
  sel = LEADS.find(l => l.id === id);
  if (!sel) return;
  const bd = scoreBreakdown(sel);

  $("#pRing").textContent = sel.score == null ? "–" : sel.score;
  $("#pRing").style.background = sel.score == null ? "#cfd6e2" : `conic-gradient(${scoreColor(sel.score)} ${sel.score * 3.6}deg, #eef1f5 0deg)`;
  $("#pRing").style.boxShadow = "inset 0 0 0 6px #fff";
  $("#pName").textContent = sel.company_name;
  $("#pMeta").textContent = `${sel.org_nr || "Org.nr ej hämtat"} · ${sel.city || "–"}`;
  $("#followup").value = sel.follow_up_date || "";

  const breakdownHtml = bd.notEnriched
    ? `<div class="notenriched">Det här bolaget är inte anrikat ännu. Klicka "⚙ Anrika 20" för att hämta finansiell data.</div>`
    : bd.parts.map(p => `
        <div class="bd-row">
          <span class="lab">${p.lab}</span>
          <span class="track"><span class="fill" style="width:${(p.pts / p.max) * 100}%;background:${scoreBarColor(p.pts, p.max)}"></span></span>
          <span class="pts">${p.pts}/${p.max}</span>
        </div>`).join("");

  $("#pBody").innerHTML = `
    <div class="p-sec"><h4>Varför den här poängen</h4>${breakdownHtml}</div>
    <div class="p-sec">
      <h4>Nyckeltal</h4>
      <div class="kpis">
        <div class="kpi"><div class="v num">${fmtMSEK(sel.revenue)}</div><div class="l">Omsättning</div></div>
        <div class="kpi"><div class="v num">${fmtMSEK(sel.result_after_fin)}</div><div class="l">Resultat e. fin</div></div>
        <div class="kpi"><div class="v num">${sel.employees ?? "–"}</div><div class="l">Anställda</div></div>
        <div class="kpi"><div class="v num">${sel.solidity != null ? sel.solidity + " %" : "–"}</div><div class="l">Soliditet</div></div>
      </div>
    </div>
    <div class="p-sec">
      <h4>Kontaktpersoner</h4>
      <div id="contactsList" style="display:flex;flex-direction:column;gap:8px;margin-bottom:12px"></div>
      <details>
        <summary style="font-size:12.5px;color:var(--accent);cursor:pointer;list-style:none;padding:4px 0">+ Lägg till kontakt</summary>
        <div class="contact-form" style="margin-top:10px">
          <input type="text" id="contactName" class="dateinput" placeholder="Namn">
          <input type="text" id="contactPhone" class="dateinput" placeholder="Telefon">
          <input type="email" id="contactEmail" class="dateinput" placeholder="E-post">
          <div class="notes-foot">
            <button class="btn btn-prim" id="saveContact">Spara kontakt</button>
            <span class="saved" id="contactSavedMsg">✓ Sparat</span>
          </div>
        </div>
      </details>
    </div>
    <div class="p-sec">
      <h4>Status</h4>
      <div class="status-switch" id="ssw">
        ${Object.entries(STATUS).map(([k, v]) => `<button class="ss-btn ${sel.status === k ? 'on' : ''}" data-s="${k}"><span class="dot"></span>${v.label}</button>`).join("")}
      </div>
    </div>
    <div class="p-sec notes-section">
      <h4>Anteckningar</h4>
      <div class="notes-meta" id="lastContact">Senaste kontakt: –</div>
      <textarea id="newNote" placeholder="Skriv en ny anteckning…"></textarea>
      <div class="notes-foot">
        <button class="btn btn-prim" id="addNoteBtn">Lägg till anteckning</button>
        <span class="saved" id="noteSavedMsg">✓ Sparat</span>
      </div>
      <div class="notes-list" id="notesList"><div class="notes-empty">Laddar anteckningar…</div></div>
    </div>`;

  document.getElementById("saveContact").onclick = async () => {
    const name  = document.getElementById("contactName").value.trim();
    const phone = document.getElementById("contactPhone").value.trim();
    const email = document.getElementById("contactEmail").value.trim();
    if (!name && !phone && !email) return;
    const { error } = await sb.from("lead_contacts").insert({ lead_id: sel.id, name, phone, email, created_at: new Date().toISOString() });
    if (!error) {
      const msg = document.getElementById("contactSavedMsg");
      msg.classList.add("show"); setTimeout(() => msg.classList.remove("show"), 2000);
      loadContacts(sel.id);
      ["contactName", "contactPhone", "contactEmail"].forEach(i => document.getElementById(i).value = "");
    } else { toast("Kunde inte spara kontakt"); console.error(error); }
  };

  document.getElementById("ssw").onclick = async e => {
    const btn = e.target.closest(".ss-btn"); if (!btn) return;
    const newStatus = btn.dataset.s;
    const ok = await patchLead(sel.id, { status: newStatus, updated_at: new Date().toISOString() });
    if (ok) {
      sel.status = newStatus;
      const lead = LEADS.find(l => l.id === sel.id);
      if (lead) lead.status = newStatus;
      document.querySelectorAll(".ss-btn").forEach(b => b.classList.toggle("on", b.dataset.s === newStatus));
      renderAll();
    }
  };

  document.getElementById("addNoteBtn").onclick = async () => {
    const txt = document.getElementById("newNote").value.trim(); if (!txt) return;
    const note = { lead_id: sel.id, note: txt, created_at: new Date().toISOString() };
    const { data, error } = await sb.from("lead_notes").insert(note).select().single();
    if (!error) {
      document.getElementById("newNote").value = "";
      const msg = document.getElementById("noteSavedMsg");
      msg.classList.add("show"); setTimeout(() => msg.classList.remove("show"), 2000);
      const el = document.getElementById("notesList");
      if (el.querySelector(".notes-empty")) el.innerHTML = "";
      el.insertAdjacentHTML("afterbegin", noteHtml(data));
      const lc = document.getElementById("lastContact");
      if (lc) lc.textContent = `Senaste kontakt: ${fmtDateTime(data.created_at)}`;
    } else { toast("Kunde inte spara anteckning"); }
  };

  $("#panel").classList.add("open");
  $("#scrim").classList.add("open");
  renderTable();

  const [notesRes] = await Promise.all([
    sb.from("lead_notes").select("*").eq("lead_id", id).order("created_at", { ascending: false })
  ]);
  if (!sel || sel.id !== id) return;
  if (notesRes.error) { document.getElementById("notesList").innerHTML = `<div class="notes-empty">Kunde inte hämta anteckningar.</div>`; }
  else { renderNotesList(notesRes.data || []); }
  loadContacts(id);
}

function closePanel() { $("#panel").classList.remove("open"); $("#scrim").classList.remove("open"); sel = null; renderTable(); }

/* ============================================================
   11. EVENTS
   ============================================================ */
$("#statusList").onclick = e => { const it = e.target.closest(".status-item"); if (!it) return; state.status = it.dataset.st; renderStatusFilter(); renderTable(); };
$("#scoreSlider").oninput = e => { state.minScore = +e.target.value; $("#scoreVal").textContent = e.target.value; e.target.style.setProperty("--p", e.target.value + "%"); renderTable(); };
$("#revMin").oninput = e => { state.revMin = e.target.value ? +e.target.value : null; renderTable(); };
$("#revMax").oninput = e => { state.revMax = e.target.value ? +e.target.value : null; renderTable(); };
$("#search").oninput = e => { state.q = e.target.value.trim(); renderTable(); };
$("#pClose").onclick = closePanel;
$("#scrim").onclick = closePanel;
$("#mapBtn").onclick = openMap;
$("#mapClose").onclick = closeMap;
$("#mapScrim").onclick = closeMap;

$("#saveFollowup").onclick = async () => {
  if (!sel) return;
  const fu = $("#followup").value || null;
  const ok = await patchLead(sel.id, { follow_up_date: fu, updated_at: new Date().toISOString() });
  if (ok) { sel.follow_up_date = fu; toast("Uppföljning sparad"); renderAll(); }
  else toast("Kunde inte spara uppföljning");
};

$("#mailBtn").onclick = async () => {
  if (!sel) return;
  const { data } = await sb.from("lead_contacts").select("name, email").eq("lead_id", sel.id).order("created_at", { ascending: true }).limit(1).maybeSingle();
  const email = data?.email?.trim();
  if (!email) { toast("Lägg till kontaktpersonens e-post först"); return; }
  const firstName = data?.name?.trim().split(" ")[0] || "";
  const msg = `Hej${firstName ? ` ${firstName}` : ""}!\n\nJag heter [Ditt namn] och jobbar på AOTO. Jag ser att ${sel.company_name} i ${sel.city || "er region"} skulle kunna frigöra rörelsekapital genom lagerfinansiering av begagnade bilar – ni betalar bara för det lager ni faktiskt har ute.\n\nHar du 15 minuter nästa vecka för ett kort samtal om hur det skulle se ut för er?\n\nVänliga hälsningar,\n[Ditt namn], AOTO`;
  window.location.href = `mailto:${email}?subject=${encodeURIComponent(`AOTO – lagerfinansiering för ${sel.company_name}`)}&body=${encodeURIComponent(msg)}`;
};

document.addEventListener("keydown", e => { if (e.key === "Escape") { closePanel(); closeSettings(); closeMap(); } });
document.querySelectorAll("thead th[data-sort]").forEach(th => th.onclick = () => {
  const k = th.dataset.sort;
  if (state.sortKey === k) state.sortDir *= -1;
  else { state.sortKey = k; state.sortDir = (k === "company_name" || k === "city" || k === "status" || k === "follow_up_date") ? 1 : -1; }
  document.querySelectorAll("thead th .ar").forEach(a => a.remove());
  const ar = document.createElement("span"); ar.className = "ar"; ar.textContent = state.sortDir > 0 ? "▲" : "▼"; th.appendChild(ar);
  renderTable();
});

/* ============================================================
   12. AUTH + INIT
   ============================================================ */
const appEl = $("#app");
let currentUserId = null;

function showApp() { appEl.style.display = "grid"; $("#authGate").classList.remove("show"); }
function showGate() { appEl.style.display = "none"; $("#authGate").classList.add("show"); appReady = false; LEADS = []; closePanel(); }

async function enterApp(session) {
  showApp();
  currentUserId = session.user.id;
  const email = session?.user?.email || "";
  $("#userEmail").textContent = email;
  $("#userAv").textContent = (email[0] || "–");
  if (appReady) return;
  appReady = true;
  try { await loadUserSettings(currentUserId); await loadLeads(); renderAll(); }
  catch (err) { console.error(err); toast("Kunde inte hämta leads – kontrollera RLS-policy"); }
}

async function doLogin() {
  const email = $("#authEmail").value.trim(), pw = $("#authPw").value;
  const btn = $("#authBtn"), err = $("#authErr");
  err.textContent = "";
  if (!email || !pw) { err.textContent = "Fyll i e-post och lösenord."; return; }
  btn.disabled = true; btn.textContent = "Loggar in…";
  const { error } = await sb.auth.signInWithPassword({ email, password: pw });
  btn.disabled = false; btn.textContent = "Logga in";
  if (error) { err.textContent = "Fel e-post eller lösenord."; }
}

(async function boot() {
  sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON);

  $("#authBtn").onclick = doLogin;
  $("#authPw").addEventListener("keydown", e => { if (e.key === "Enter") doLogin(); });
  $("#authEmail").addEventListener("keydown", e => { if (e.key === "Enter") $("#authPw").focus(); });
  $("#logoutBtn").onclick = () => sb.auth.signOut();
  $("#settingsBtn").onclick = openSettings;
  $("#modalClose").onclick = closeSettings;
  $("#modalCancel").onclick = closeSettings;
  $("#modalScrim").onclick = closeSettings;
  $("#modalSave").onclick = () => saveScoring(currentUserId);

  $("#saveFiltersBtn").onclick = async () => {
    if (!currentUserId) return;
    const ok = await saveUserSettings(currentUserId, { minScore: state.minScore, revMin: state.revMin, revMax: state.revMax });
    if (ok) { const msg = $("#filterSavedMsg"); msg.classList.add("show"); setTimeout(() => msg.classList.remove("show"), 2000); }
    else toast("Kunde inte spara filter");
  };

  const importBtn = $("#importBtn"); importBtn.style.display = "";
  importBtn.onclick = async () => {
    importBtn.disabled = true; importBtn.textContent = "Importerar…";
    try {
      const { data: { session: s } } = await sb.auth.getSession();
      if (!s) { toast("Du måste vara inloggad"); return; }
      const res = await fetch("/.netlify/functions/roaring-import", { method: "POST", headers: { Authorization: "Bearer " + s.access_token } });
      const body = await res.json();
      if (body.success) { toast(body.message); await loadLeads(); renderAll(); }
      else toast("Import misslyckades: " + (body.error || res.status));
    } catch (err) { toast("Import-fel: " + err.message); }
    finally { importBtn.disabled = false; importBtn.textContent = "⬇ Importera"; }
  };

  const enrichBtn = $("#enrichBtn"); enrichBtn.style.display = "";
  enrichBtn.onclick = async () => {
    enrichBtn.disabled = true; enrichBtn.textContent = "Anrikar…";
    try {
      const { data: { session: s } } = await sb.auth.getSession();
      if (!s) { toast("Du måste vara inloggad"); return; }
      const res = await fetch("/.netlify/functions/roaring-enrich", { method: "POST", headers: { Authorization: "Bearer " + s.access_token } });
      const body = await res.json();
      if (body.success) { toast(body.message); await loadLeads(); renderAll(); }
      else toast("Anrikning misslyckades: " + (body.error || res.status));
    } catch (err) { toast("Anrik-fel: " + err.message); }
    finally { enrichBtn.disabled = false; enrichBtn.textContent = "⚙ Anrika 20"; }
  };

  const geocodeBtn = $("#geocodeBtn"); geocodeBtn.style.display = "";
  geocodeBtn.onclick = async () => {
    geocodeBtn.disabled = true; geocodeBtn.textContent = "Geocodar…";
    try {
      const { data: { session: s } } = await sb.auth.getSession();
      if (!s) { toast("Du måste vara inloggad"); return; }
      const res = await fetch("/.netlify/functions/geocode", { method: "POST", headers: { Authorization: "Bearer " + s.access_token } });
      const body = await res.json();
      if (body.success) { toast(body.message); await loadLeads(); renderAll(); }
      else toast("Geocoding misslyckades: " + (body.error || res.status));
    } catch (err) { toast("Geocode-fel: " + err.message); }
    finally { geocodeBtn.disabled = false; geocodeBtn.textContent = "📍 Geocoda"; }
  };

  const { data: { session } } = await sb.auth.getSession();
  if (session) enterApp(session); else showGate();

  sb.auth.onAuthStateChange((event, s) => {
    if (event === "SIGNED_IN" && s) enterApp(s);
    if (event === "SIGNED_OUT") showGate();
  });
})();
</script>
