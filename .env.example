# Kopiera till .env och fyll i värden (filen .env committas inte)
# netlify dev läser automatiskt in dessa som process.env i functions/

# --- Bilstatistik API ---
# Använd exakt de namn/typer ni fått (user+lösenord, client id/secret, API-nyckel, osv.)
BILSTATISTIK_USERNAME=
BILSTATISTIK_PASSWORD=
# Valfritt om ni fått en separat bas-URL
# BILSTATISTIK_API_URL=

# --- Befintliga (sätts ofta redan i Netlify UI) ---
# ROARING_CLIENT_ID=
# ROARING_CLIENT_SECRET=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SERVICE_ROLE_KEY=
